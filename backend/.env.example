# PostgreSQL 接続先（docker-compose.yml の値と合わせる）
DATABASE_URL=postgresql://highdea:highdea@localhost:5432/highdea
# ログイン用 JWT の署名鍵。32文字以上のランダム値（例: openssl rand -hex 32）。絶対にコミットしない
JWT_SECRET=change-me-to-at-least-32-random-characters
PORT=3000
# production にすると Cookie に Secure が付く
NODE_ENV=development
# 許可するフロントエンドのオリジン（Vite プロキシ経由なら不要だが安全のため設定）
CORS_ORIGIN=http://localhost:5173
# 開発時のアップロード画像の保存先
UPLOAD_DIR=./uploads
